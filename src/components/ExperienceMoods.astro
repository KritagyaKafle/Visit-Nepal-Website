---
import { Sparkles, Wind, Footprints, Bird } from '@lucide/astro';

const moods = [
  {
    icon: Sparkles,
    title: 'Sacred Mornings',
    tagline: 'Spiritual Awakening',
    desc: 'Golden dawn light breaking over ancient stupas, accompanied by the gentle ringing of temple bells and butter lamps glowing in quiet shrines.'
  },
  {
    icon: Wind,
    title: 'Mountain Silence',
    tagline: 'High Altitude Calm',
    desc: 'Standing amidst giant peaks where clouds drift below your feet, inhaling crisp alpine air in the quiet sanctuary of the high Himalayas.'
  },
  {
    icon: Footprints,
    title: 'Heritage Walks',
    tagline: 'Living History',
    desc: 'Wandering through medieval brick alleyways, carved courtyard doorways, artisan pottery squares, and centuries of preserved culture.'
  },
  {
    icon: Bird,
    title: 'Peaceful Gardens',
    tagline: 'Serene Reflection',
    desc: 'Reflecting beside mirror-like mountain lakes, lotus ponds, and monastery courtyards where peace settles deep into the soul.'
  }
];
---

<section class="moods-section" id="moods">
  <div class="container">
    <div class="section-title-wrap">
      <h2>EXPERIENCE MOODS</h2>
      <div class="section-title-rule"></div>
    </div>

    <div class="moods-grid">
      {moods.map((mood) => {
        const Icon = mood.icon;
        return (
          <div class="glass-card mood-card">
            <div class="mood-icon-wrap">
              <Icon class="mood-icon" />
            </div>
            <span class="mood-tagline">{mood.tagline}</span>
            <h3 class="mood-title">{mood.title}</h3>
            <p class="mood-desc">{mood.desc}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .moods-section {
    padding: 7rem 0;
    position: relative;
    background: linear-gradient(180deg, var(--himalayan-night) 0%, rgba(18, 24, 32, 0.7) 50%, var(--himalayan-night) 100%);
  }

  .moods-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
    margin-top: 2rem;
  }

  .mood-card {
    padding: 2.25rem 1.75rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .mood-icon-wrap {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(215, 168, 77, 0.1);
    border: 1px solid var(--glass-border-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .mood-icon {
    width: 28px;
    height: 28px;
    color: var(--temple-gold);
  }

  .mood-tagline {
    font-size: 0.75rem;
    color: var(--temple-gold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .mood-title {
    font-size: 1.35rem;
    color: var(--snow-white);
    margin-bottom: 0.75rem;
  }

  .mood-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 1100px) {
    .moods-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 576px) {
    .moods-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
