---
import { Sparkles, Wind, Footprints } from '@lucide/astro';

const moods = [
  {
    icon: Sparkles,
    title: 'Sacred Mornings',
    tagline: 'Spiritual Awakening',
    desc: 'Golden dawn light breaking over ancient pagoda shrines and stupa courtyards.'
  },
  {
    icon: Wind,
    title: 'Mountain Silence',
    tagline: 'High Altitude Calm',
    desc: 'Standing amidst giant snowy crests where crisp alpine air meets quiet horizons.'
  },
  {
    icon: Footprints,
    title: 'Heritage Walks',
    tagline: 'Living History',
    desc: 'Wandering medieval brick plaza alleys, carved wooden doorways, and artisan squares.'
  }
];
---

<section class="moods-section section-bg" id="moods">
  <div class="container">
    <div class="section-title-wrap">
      <h2>EXPERIENCE MOODS</h2>
      <div class="section-title-rule"></div>
    </div>

    <div class="moods-grid">
      {moods.map((mood) => {
        const Icon = mood.icon;
        return (
          <div class="glass-card mood-card">
            <div class="mood-icon-wrap">
              <Icon class="mood-icon" />
            </div>
            <span class="mood-tagline">{mood.tagline}</span>
            <h3 class="mood-title">{mood.title}</h3>
            <p class="mood-desc">{mood.desc}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .moods-section {
    padding: 9rem 0;
    background-image: url('/images/everest.jpg');
  }

  .moods-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }

  .mood-card {
    padding: 2.25rem 1.75rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .mood-icon-wrap {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: rgba(215, 168, 77, 0.1);
    border: 1px solid var(--glass-border-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .mood-icon {
    width: 24px;
    height: 24px;
    color: var(--temple-gold);
  }

  .mood-tagline {
    font-size: 0.75rem;
    color: var(--temple-gold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .mood-title {
    font-size: 1.35rem;
    color: var(--snow-white);
    margin-bottom: 0.75rem;
  }

  .mood-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 992px) {
    .moods-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
