---
interface Props {
  id: string;
  name: string;
  subtitle: string;
  mood: string;
  description: string;
  image: string;
}

const { id, name, subtitle, mood, description, image } = Astro.props;
---

<div class="glass-card place-card" data-place-id={id}>
  <div class="place-image-wrap">
    <img src={image} alt={name} loading="lazy" class="place-img" />
    <div class="place-overlay"></div>
    <span class="glass-pill place-mood-badge">{mood}</span>
  </div>

  <div class="place-card-body">
    <div class="place-header">
      <h3 class="place-title">{name}</h3>
      <span class="place-subtitle">{subtitle}</span>
    </div>
    <p class="place-desc">{description}</p>
    <div class="place-card-footer">
      <a href="#journey" class="place-explore-link">
        Explore Place &rarr;
      </a>
    </div>
  </div>
</div>

<style>
  .place-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .place-image-wrap {
    position: relative;
    width: 100%;
    height: 240px;
    overflow: hidden;
  }

  .place-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .place-card:hover .place-img {
    transform: scale(1.08);
  }

  .place-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(5, 7, 10, 0.1) 0%, rgba(5, 7, 10, 0.8) 100%);
  }

  .place-mood-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--temple-gold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .place-card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .place-header {
    margin-bottom: 1rem;
  }

  .place-title {
    font-size: 1.5rem;
    color: var(--snow-white);
    margin-bottom: 0.25rem;
  }

  .place-subtitle {
    font-size: 0.8125rem;
    color: var(--temple-gold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .place-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .place-card-footer {
    border-top: 1px solid rgba(174, 184, 181, 0.1);
    padding-top: 1rem;
  }

  .place-explore-link {
    color: var(--temple-gold);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: inline-block;
  }

  .place-explore-link:hover {
    color: var(--snow-white);
    transform: translateX(4px);
  }
</style>
