---
interface Props {
  id: string;
  name: string;
  subtitle: string;
  mood: string;
  description: string;
  image: string;
}

const { id, name, subtitle, mood, description, image } = Astro.props;
---

<div class="glass-card place-card" data-place-id={id}>
  <div class="place-image-wrap">
    <img src={image} alt={name} loading="lazy" class="place-img" />
    <div class="place-overlay"></div>
    <span class="glass-pill place-mood-badge">{mood}</span>
  </div>

  <div class="place-card-body">
    <div class="place-header">
      <h3 class="place-title">{name}</h3>
      <span class="place-subtitle">{subtitle}</span>
    </div>
    <p class="place-desc">{description}</p>
    <div class="place-card-footer">
      <a href="#journey" class="place-explore-link">
        Discover Landmark &rarr;
      </a>
    </div>
  </div>
</div>

<style>
  .place-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
    border: 1px solid rgba(174, 184, 181, 0.18);
  }

  .place-card:hover {
    transform: translateY(-8px) rotateX(4deg) rotateY(-2deg) scale(1.02);
    border-color: var(--temple-gold);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7), 0 0 30px rgba(215, 168, 77, 0.25);
  }

  .place-image-wrap {
    position: relative;
    width: 100%;
    height: 280px;
    overflow: hidden;
  }

  .place-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .place-card:hover .place-img {
    transform: scale(1.1);
  }

  .place-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(5, 7, 10, 0.15) 0%, rgba(5, 7, 10, 0.85) 100%);
  }

  .place-mood-badge {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--temple-gold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgba(5, 7, 10, 0.7);
    border: 1px solid var(--glass-border-gold);
  }

  .place-card-body {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    background: rgba(10, 14, 20, 0.6);
  }

  .place-header {
    margin-bottom: 1rem;
  }

  .place-title {
    font-size: 1.6rem;
    color: var(--snow-white);
    margin-bottom: 0.35rem;
  }

  .place-subtitle {
    font-size: 0.85rem;
    color: var(--temple-gold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .place-desc {
    font-size: 0.975rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.75rem;
    flex-grow: 1;
  }

  .place-card-footer {
    border-top: 1px solid rgba(174, 184, 181, 0.12);
    padding-top: 1.25rem;
  }

  .place-explore-link {
    color: var(--temple-gold);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.3s ease, transform 0.3s ease;
    display: inline-block;
  }

  .place-explore-link:hover {
    color: var(--snow-white);
    transform: translateX(6px);
  }
</style>
