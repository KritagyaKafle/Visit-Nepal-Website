---
import { Mountain, Flame, Sun, Heart } from '@lucide/astro';
---

<section class="about-section" id="about">
  <div class="container relative-z">
    <!-- Section Header matching design-brief.md -->
    <div class="section-title-wrap">
      <h2>ABOUT NEPAL</h2>
      <div class="section-title-rule"></div>
    </div>

    <!-- Short Emotional Introduction (IA Section 2) -->
    <div class="about-grid">
      <div class="about-lead">
        <h3 class="about-heading">
          A Sanctuary of Mountains, Ancient Wisdom & Unrivaled Majesty
        </h3>
        <p class="about-text">
          Nestled between the snowy crests of the world's highest peaks and ancient valley sanctuaries, Nepal is a land where culture, mountains, heritage, and peace breathe in eternal harmony. From the sacred flame of Pashupatinath to the peaceful gardens of Lumbini, experience a realm like nowhere else on Earth.
        </p>
      </div>

      <!-- 4 Core Pillars (Mountains, Heritage, Peace, Hospitality) -->
      <div class="about-pillars">
        <div class="glass-card pillar-card">
          <Mountain class="pillar-icon" />
          <h4>Eight-Thousanders</h4>
          <p>Home to eight of the world's fourteen highest mountain peaks including Mount Everest.</p>
        </div>

        <div class="glass-card pillar-card">
          <Flame class="pillar-icon" />
          <h4>Sacred Heritage</h4>
          <p>Millennia of living traditions, golden stupas, and ancient wooden pagoda temples.</p>
        </div>

        <div class="glass-card pillar-card">
          <Sun class="pillar-icon" />
          <h4>Peaceful Gardens</h4>
          <p>Serene lotus ponds, sacred stupa courtyards, and tranquil Himalayan sunrise vistas.</p>
        </div>

        <div class="glass-card pillar-card">
          <Heart class="pillar-icon" />
          <h4>Warm Hospitality</h4>
          <p>Experience Namaste — a genuine greeting of respect and soul-deep welcoming spirit.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 9rem 0;
    position: relative;
    background: transparent;
  }

  .relative-z {
    position: relative;
    z-index: 2;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .about-heading {
    font-size: clamp(2rem, 3.8vw, 3rem);
    line-height: 1.25;
    margin-bottom: 1.5rem;
    color: var(--snow-white);
  }

  .about-text {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--mist-slate);
  }

  .about-pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .pillar-card {
    padding: 2rem 1.75rem;
    background: rgba(10, 14, 20, 0.7);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .pillar-icon {
    width: 28px;
    height: 28px;
    color: var(--temple-gold);
    margin-bottom: 1rem;
  }

  .pillar-card h4 {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--snow-white);
    margin-bottom: 0.5rem;
  }

  .pillar-card p {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 992px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 576px) {
    .about-pillars {
      grid-template-columns: 1fr;
    }
  }
</style>
