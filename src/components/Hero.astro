---
import { ArrowDown, Compass } from '@lucide/astro';
---

<section class="hero-section" id="hero">
  <!-- Hero Main Content -->
  <div class="container hero-container">
    <div class="hero-content">
      <div class="glass-pill hero-badge">
        <Compass class="badge-icon" />
        <span>NEPAL • ROOF OF THE WORLD</span>
      </div>

      <h1 class="hero-title">
        Land of Sacred Peaks <br />
        <span class="gold-text">& Timeless Spirit</span>
      </h1>

      <p class="hero-subtitle">
        Discover Nepal's 8 extraordinary Himalayan landmarks, UNESCO heritage shrines, and serene alpine valleys.
      </p>

      <div class="hero-actions">
        <a href="#places" class="glass-button hero-cta-primary">
          Discover Nepal
        </a>
        <a href="#about" class="hero-scroll-btn" aria-label="Scroll down">
          <ArrowDown class="scroll-icon" />
          <span>Explore</span>
        </a>
      </div>
    </div>

    <!-- Highlight Overlay Cards -->
    <div class="hero-highlights">
      <div class="glass-card highlight-card">
        <span class="highlight-num">01</span>
        <div class="highlight-info">
          <h4>8,848m</h4>
          <p>Everest Peak</p>
        </div>
      </div>

      <div class="glass-card highlight-card">
        <span class="highlight-num">02</span>
        <div class="highlight-info">
          <h4>UNESCO</h4>
          <p>World Heritage</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Vertical Social Icons (Right Side) -->
  <div class="hero-socials">
    <a href="#" aria-label="Instagram" class="social-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
    </a>
    <a href="#" aria-label="Facebook" class="social-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
    </a>
    <a href="#" aria-label="Share" class="social-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="10.51" y2="6.49"/><line x1="15.41" x2="8.59" y1="17.51" y2="13.49"/></svg>
    </a>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 100px;
    padding-bottom: 60px;
    overflow: hidden;
    background: transparent;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 70vh;
  }

  .hero-content {
    max-width: 680px;
    margin-top: 2.5rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--temple-gold);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    margin-bottom: 1.5rem;
    padding: 6px 16px;
    background: rgba(5, 7, 10, 0.65);
    border: 1px solid var(--glass-border-gold);
  }

  .badge-icon {
    width: 15px;
    height: 15px;
    color: var(--temple-gold);
  }

  .hero-title {
    margin-bottom: 1.5rem;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.1;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.9);
  }

  .gold-text {
    color: var(--temple-gold);
    font-style: italic;
    background: linear-gradient(135deg, var(--lumbini-sand) 0%, var(--temple-gold) 50%, #b88628 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
    color: var(--snow-white);
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.95);
    max-width: 55ch;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .hero-cta-primary {
    font-size: 0.875rem;
    padding: 14px 32px;
  }

  .hero-scroll-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--snow-white);
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    transition: color var(--transition-fast);
  }

  .hero-scroll-btn:hover {
    color: var(--temple-gold);
  }

  .scroll-icon {
    width: 16px;
    height: 16px;
    animation: bounce 2s infinite;
  }

  /* Highlight Cards at bottom of Hero */
  .hero-highlights {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-top: 4rem;
    max-width: 500px;
  }

  .highlight-card {
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(10, 14, 20, 0.65);
    border: 1px solid var(--glass-border-gold);
    flex: 1;
  }

  .highlight-num {
    font-family: var(--font-display);
    color: var(--temple-gold);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .highlight-info h4 {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--snow-white);
  }

  .highlight-info p {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* Social Icons */
  .hero-socials {
    position: absolute;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    z-index: 10;
  }

  .social-icon {
    color: var(--mist-slate);
    width: 20px;
    height: 20px;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .social-icon:hover {
    color: var(--temple-gold);
    transform: scale(1.15);
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(6px); }
    60% { transform: translateY(3px); }
  }

  @media (max-width: 992px) {
    .hero-socials {
      display: none;
    }
    .hero-highlights {
      flex-direction: column;
    }
  }
</style>
