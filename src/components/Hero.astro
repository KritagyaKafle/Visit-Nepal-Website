---
import { ArrowDown } from '@lucide/astro';
---

<section class="hero-section" id="hero">
  <!-- Mountain Background & Overlay -->
  <div class="hero-bg-container">
    <div class="hero-bg-image"></div>
    <div class="hero-bg-gradient"></div>
    <div class="hero-bg-fog"></div>
    <div class="hero-bg-text bg-text-hero">NEPAL</div>
  </div>

  <!-- Hero Main Content -->
  <div class="container hero-container">
    <div class="hero-content">


      <h1 class="hero-title">
        Land of Sacred Peaks <br />
        <span class="gold-text">& Timeless Spirit</span>
      </h1>

      <p class="hero-subtitle">
        Journey into the heart of the Himalayas. Experience ancient UNESCO heritage, mountain tranquility, and majestic landscapes like nowhere else on Earth.
      </p>

      <div class="hero-actions">
        <a href="#places" class="glass-button">
          Discover Nepal
        </a>
        <a href="#about" class="hero-scroll-btn" aria-label="Scroll down">
          <ArrowDown class="scroll-icon" />
          <span>Explore</span>
        </a>
      </div>
    </div>

    <!-- Highlight Overlay Cards -->
    <div class="hero-highlights">
      <div class="glass-card highlight-card">
        <span class="highlight-num">01</span>
        <div class="highlight-info">
          <h4>8,848m</h4>
          <p>Mount Everest Peak</p>
        </div>
      </div>

      <div class="glass-card highlight-card">
        <span class="highlight-num">02</span>
        <div class="highlight-info">
          <h4>UNESCO</h4>
          <p>World Heritage</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Vertical Social Icons (Right Side) -->
  <div class="hero-socials">
    <a href="#" aria-label="Instagram" class="social-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
    </a>
    <a href="#" aria-label="Facebook" class="social-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
    </a>
    <a href="#" aria-label="Share" class="social-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="10.51" y2="6.49"/><line x1="15.41" x2="8.59" y1="17.51" y2="13.49"/></svg>
    </a>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  // Hero Parallax Animation
  document.addEventListener('DOMContentLoaded', () => {
    const bgText = document.querySelector('.hero-bg-text');
    const heroTitle = document.querySelector('.hero-title');
    
    window.addEventListener('scroll', () => {
      const scrollY = window.scrollY;
      if (bgText) {
        gsap.to(bgText, { y: scrollY * 0.4, opacity: 1 - scrollY / 700, duration: 0.1 });
      }
      if (heroTitle) {
        gsap.to(heroTitle, { y: scrollY * 0.15, duration: 0.1 });
      }
    });
  });
</script>

<style>
  .hero-section {
    position: relative;
    min-height: 110vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 100px;
    padding-bottom: 60px;
    overflow: hidden;
  }

  /* Background setup with real mountain photo background */
  .hero-bg-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .hero-bg-image {
    width: 100%;
    height: 100%;
    background-image: url('https://images.unsplash.com/photo-1544735716-392fe2489ffa?q=80&w=2000&auto=format&fit=crop');
    background-size: cover;
    background-position: center 30%;
    filter: brightness(0.75) contrast(1.1);
  }

  .hero-bg-gradient {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, rgba(5, 7, 10, 0.3) 0%, rgba(5, 7, 10, 0.85) 80%),
                linear-gradient(to bottom, rgba(5, 7, 10, 0.4) 0%, rgba(5, 7, 10, 1) 100%);
  }

  .hero-bg-fog {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.1) 0%, transparent 60%);
    background-size: 200% 200%;
    animation: fogMovement 15s ease-in-out infinite alternate;
    z-index: 1;
  }

  @keyframes fogMovement {
    0% { background-position: 0% 50%; opacity: 0.3; }
    50% { opacity: 0.6; }
    100% { background-position: 100% 50%; opacity: 0.3; }
  }

  .hero-bg-text {
    position: absolute;
    top: 15%;
    left: 50%;
    transform: translateX(-50%);
    font-size: clamp(12rem, 30vw, 32rem);
    line-height: 1;
    z-index: 1;
  }

  .hero-container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 75vh;
  }

  .hero-content {
    max-width: 700px;
    margin-top: 4rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--temple-gold);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--temple-gold);
    box-shadow: 0 0 8px var(--temple-gold);
  }

  .hero-title {
    margin-bottom: 2rem;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
  }

  .gold-text {
    color: var(--temple-gold);
    font-style: italic;
  }

  .hero-subtitle {
    font-size: 1.2rem;
    line-height: 1.7;
    margin-bottom: 3.5rem;
    color: var(--mist-slate);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .hero-scroll-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--snow-white);
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    transition: color var(--transition-fast);
  }

  .hero-scroll-btn:hover {
    color: var(--temple-gold);
  }

  .scroll-icon {
    width: 18px;
    height: 18px;
    animation: bounce 2s infinite;
  }

  /* Highlight Cards at bottom of Hero */
  .hero-highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2.5rem;
    margin-top: 5rem;
  }

  .highlight-card {
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .highlight-num {
    font-family: var(--font-display);
    color: var(--temple-gold);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .highlight-info h4 {
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--snow-white);
  }

  .highlight-info p {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* Social Icons */
  .hero-socials {
    position: absolute;
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    z-index: 10;
  }

  .social-icon {
    color: var(--mist-slate);
    width: 20px;
    height: 20px;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .social-icon:hover {
    color: var(--temple-gold);
    transform: scale(1.15);
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(6px); }
    60% { transform: translateY(3px); }
  }

  @media (max-width: 992px) {
    .hero-socials {
      display: none;
    }
  }
</style>
