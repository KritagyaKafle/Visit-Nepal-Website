---
import ScrollTiltedGrid from './ui/scroll-tilted-grid.astro';

const places = [
  {
    id: 'pashupatinath',
    name: 'Pashupatinath',
    subtitle: 'Sacred Hindu Temple Sanctuary',
    mood: 'Sacred',
    description: 'Ancient pagoda temple complex on the Bagmati River banks with sacred golden roofs & evening Aarati ceremonies.',
    image: '/images/pashupatinath.jpg'
  },
  {
    id: 'swayambhu',
    name: 'Swayambhunath Stupa',
    subtitle: 'The Ancient Monkey Temple',
    mood: 'Heritage',
    description: 'Iconic 5th-century Buddhist stupa atop a Kathmandu hilltop with Buddha eyes looking across the valley.',
    image: '/images/swayambhu.jpg'
  },
  {
    id: 'lumbini',
    name: 'Lumbini Sacred Garden',
    subtitle: 'Birthplace of Lord Buddha',
    mood: 'Peace',
    description: 'UNESCO World Heritage sanctuary housing the Mayadevi Temple, Ashoka Pillar, and serene peace gardens.',
    image: '/images/lumbini.jpg'
  },
  {
    id: 'everest',
    name: 'Mount Everest & Khumbu',
    subtitle: 'Sagarmatha • 8,848 Meters',
    mood: 'Majesty',
    description: 'The highest summit on Earth soaring into the azure sky above the Khumbu glacier and Sherpa passes.',
    image: '/images/everest.jpg'
  },
  {
    id: 'annapurna',
    name: 'Annapurna & Machapuchare',
    subtitle: 'Sacred Fishtail Mountain Peak',
    mood: 'Sunrise',
    description: 'Untouched Holy Peak of Machapuchare towering over the Annapurna sanctuary with golden dawn rays.',
    image: '/images/annapurna.jpg'
  },
  {
    id: 'pokhara',
    name: 'Pokhara & Phewa Lake',
    subtitle: 'Himalayan Mirror Waters',
    mood: 'Tranquility',
    description: 'Tranquil alpine lake reflecting snowcapped Himalayan ranges, featuring colorful wooden boats & island temples.',
    image: '/images/pokhara.jpg'
  },
  {
    id: 'bhaktapur',
    name: 'Bhaktapur Durbar Square',
    subtitle: 'City of Devotees & Living Art',
    mood: 'Culture',
    description: 'Preserved medieval kingdom square featuring the 55-Window Palace and 5-story Nyatapola Temple.',
    image: '/images/bhaktapur.jpg'
  },
  {
    id: 'chitwan',
    name: 'Chitwan National Park',
    subtitle: 'Subtropical Jungle Wildlife',
    mood: 'Wilderness',
    description: 'Unspoiled UNESCO rainforest refuge protecting the Great One-Horned Rhinoceros and river canoe safaris.',
