---

<section class="places-section section-bg" id="places">
  <div class="container">
    <!-- Section Header -->
    <div class="section-title-wrap">
      <h2>FEATURED DESTINATIONS</h2>
      <div class="section-title-rule"></div>
    </div>

    <!-- Side-Scroll 3D Tilted Grid Component -->
    <ScrollTiltedGrid items={places} />
  </div>
</section>

<style>
  .places-section {
    padding: 8rem 0;
    position: relative;
    background: url('/images/hero-himalayas.jpg') center/cover fixed;
  }

  .places-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(5,7,10,0.95) 0%, rgba(10,14,20,0.85) 50%, rgba(5,7,10,0.95) 100%);
    z-index: 0;
  }

  .places-section > .container {
    position: relative;
    z-index: 1;
  }
</style>
