---
import { Compass } from '@lucide/astro';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-bar glass-panel">
      <!-- Footer Logo -->
      <a href="#" class="footer-brand">
        <Compass class="footer-logo-icon" />
        <span>VISIT NEPAL</span>
      </a>

      <!-- Footer Nav Links -->
      <ul class="footer-links">
        <li><a href="#about">About</a></li>
        <li><a href="#places">Places</a></li>
        <li><a href="#journey">Journey</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>

      <!-- Footer CTA -->
      <a href="#places" class="glass-pill footer-cta">
        Discover Nepal
      </a>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {new Date().getFullYear()} Visit Nepal. Promotional Destination Experience.
      </p>

      <div class="footer-socials">
        <a href="#" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
        </a>
        <a href="#" aria-label="Facebook">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="#" aria-label="Share">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="10.51" y2="6.49"/><line x1="15.41" x2="8.59" y1="17.51" y2="13.49"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 3rem 0 2rem 0;
    background: var(--himalayan-night);
    border-top: 1px solid rgba(174, 184, 181, 0.08);
  }

  .footer-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    border-radius: var(--radius-pill);
    background: rgba(10, 14, 20, 0.5);
    margin-bottom: 2rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--snow-white);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .footer-logo-icon {
    width: 20px;
    height: 20px;
    color: var(--temple-gold);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }

  .footer-links a {
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--temple-gold);
  }

  .footer-cta {
    font-size: 0.8125rem;
    color: var(--snow-white);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .footer-cta:hover {
    border-color: var(--temple-gold);
    color: var(--temple-gold);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem;
  }

  .copyright {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .social-icon {
    width: 18px;
    height: 18px;
    color: var(--text-muted);
    transition: color var(--transition-fast);
  }

  .social-icon:hover {
    color: var(--temple-gold);
  }

  @media (max-width: 768px) {
    .footer-bar {
      flex-direction: column;
      gap: 1.25rem;
      border-radius: var(--radius-md);
      padding: 1.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
