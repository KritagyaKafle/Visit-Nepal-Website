---
import { Send, Compass } from '@lucide/astro';
---

<section class="contact-section section-bg" id="contact">
  <div class="container">
    <div class="contact-card-wrap glass-card">
      <div class="contact-header">
        <div class="brand-emblem">
          <Compass class="emblem-icon" />
        </div>
        <span class="contact-badge">INQUIRIES & DISCOVERY</span>
        <h2 class="contact-title">Begin Your Himalayan Story</h2>
        <p class="contact-sub">Have questions about destinations or landmarks? Connect with us.</p>
      </div>

      <form class="contact-form" onsubmit="event.preventDefault(); alert('Thank you for reaching out to Visit Nepal!');">
        <div class="form-row">
          <div class="form-group">
            <label for="name" class="form-label">Full Name</label>
            <input type="text" id="name" required placeholder="Maya Lin" class="glass-input" />
          </div>
          <div class="form-group">
            <label for="email" class="form-label">Email Address</label>
            <input type="email" id="email" required placeholder="maya@example.com" class="glass-input" />
          </div>
        </div>

        <div class="form-group">
          <label for="message" class="form-label">Inquiry Message</label>
          <textarea id="message" rows="3" required placeholder="Share the landmarks or regions you wish to discover..." class="glass-input glass-textarea"></textarea>
        </div>

        <button type="submit" class="glass-button form-submit-btn">
          <span>Discover Nepal</span>
          <Send class="submit-icon" />
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 7rem 0 9rem 0;
    position: relative;
    background: url('/images/hero-himalayas.jpg') center/cover fixed;
  }

  .contact-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(5,7,10,0.92) 0%, rgba(10,14,20,0.85) 50%, rgba(5,7,10,0.95) 100%);
    z-index: 0;
  }

  .contact-section > .container {
    position: relative;
    z-index: 1;
  }

  .contact-card-wrap {
    max-width: 620px;
    margin: 0 auto;
    padding: 3rem 3.5rem;
    background: rgba(10, 14, 20, 0.78);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border: 1px solid var(--glass-border-gold);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.8), 0 0 40px rgba(215, 168, 77, 0.15);
  }

  .contact-header {
    text-align: center;
    margin-bottom: 2.25rem;
  }

  .brand-emblem {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(215, 168, 77, 0.12);
    border: 1px solid var(--glass-border-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem auto;
  }

  .emblem-icon {
    width: 22px;
    height: 22px;
    color: var(--temple-gold);
  }

  .contact-badge {
    font-size: 0.75rem;
    color: var(--temple-gold);
    letter-spacing: 0.14em;
    font-weight: 600;
    margin-bottom: 0.5rem;
    display: block;
  }

  .contact-title {
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    color: var(--snow-white);
    margin-bottom: 0.5rem;
  }

  .contact-sub {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin: 0;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.8125rem;
    color: var(--mist-slate);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .glass-textarea {
    resize: vertical;
  }

  .form-submit-btn {
    width: 100%;
    justify-content: center;
    margin-top: 0.75rem;
    padding: 16px 32px;
  }

  .submit-icon {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }
    .contact-card-wrap {
      padding: 2.25rem 1.75rem;
    }
  }
</style>
