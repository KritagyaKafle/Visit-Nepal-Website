---
interface DestinationItem {
  id: string;
  name: string;
  subtitle: string;
  mood: string;
  description: string;
  image: string;
}

interface Props {
  items?: DestinationItem[];
}

const { items = [] } = Astro.props;
---

<div class="scroll-tilted-grid-wrapper" id="tiltedGridWrapper">
  <div class="tilted-grid-perspective">
    <div class="tilted-grid-track" id="tiltedGridTrack">
      {items.map((item, index) => (
        <div class="glass-card tilted-grid-item" data-index={index}>
          <div class="item-img-wrap">
            <img src={item.image} alt={item.name} loading="lazy" class="item-img" />
            <div class="item-img-overlay"></div>
            <span class="glass-pill item-mood-badge">{item.mood}</span>
          </div>

          <div class="item-body">
            <span class="item-index">0{index + 1}</span>
            <h3 class="item-name">{item.name}</h3>
            <span class="item-sub">{item.subtitle}</span>
            <p class="item-desc">{item.description}</p>
            <a href="#contact" class="item-link">Discover Landmark &rarr;</a>
          </div>
        </div>
      ))}
    </div>
  </div>
  
  <!-- Side Scroll Direction Helper -->
  <div class="side-scroll-hint">
    <span class="hint-dot"></span>
    <span>Scroll down to navigate horizontal 3D landmarks track</span>
  </div>
</div>

<style>
  .scroll-tilted-grid-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 2rem 0;
  }

  .tilted-grid-perspective {
    perspective: 1400px;
    perspective-origin: 50% 30%;
    overflow: hidden;
    padding: 2rem 0;
  }

  .tilted-grid-track {
    display: flex;
    gap: 2.5rem;
    width: max-content;
    transform-style: preserve-3d;
    will-change: transform;
    padding: 0 2rem;
  }

  .tilted-grid-item {
    width: 380px;
    flex-shrink: 0;
    overflow: hidden;
    transform-style: preserve-3d;
    transform: rotateY(-14deg) rotateX(8deg) scale(0.94);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
    border: 1px solid rgba(174, 184, 181, 0.2);
  }

  .tilted-grid-item:hover {
    transform: rotateY(0deg) rotateX(0deg) scale(1.03) translateY(-10px);
    border-color: var(--temple-gold);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.8), 0 0 35px rgba(215, 168, 77, 0.3);
  }

  .item-img-wrap {
    position: relative;
    width: 100%;
    height: 240px;
    overflow: hidden;
  }

  .item-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tilted-grid-item:hover .item-img {
    transform: scale(1.1);
  }

  .item-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(5, 7, 10, 0.15) 0%, rgba(5, 7, 10, 0.85) 100%);
  }

  .item-mood-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--temple-gold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgba(5, 7, 10, 0.75);
    border: 1px solid var(--glass-border-gold);
  }

  .item-body {
    padding: 1.75rem;
    background: rgba(10, 14, 20, 0.7);
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .item-index {
    font-family: var(--font-display);
    color: var(--temple-gold);
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .item-name {
    font-size: 1.4rem;
    color: var(--snow-white);
    margin-bottom: 0.25rem;
  }

  .item-sub {
    font-size: 0.8rem;
    color: var(--temple-gold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .item-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .item-link {
    color: var(--temple-gold);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 0.3s ease, transform 0.3s ease;
    display: inline-block;
  }

  .item-link:hover {
    color: var(--snow-white);
    transform: translateX(6px);
  }

  .side-scroll-hint {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 1.5rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
  }

  .hint-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--temple-gold);
    box-shadow: 0 0 10px var(--temple-gold);
    animation: blink 1.5s infinite alternate;
  }

  @keyframes blink {
    0% { opacity: 0.3; }
    100% { opacity: 1; }
  }

  @media (max-width: 600px) {
    .tilted-grid-item {
      width: 300px;
    }
  }
</style>
